# ══════════════════════════════════════════
# Monitor Suite 环境变量配置
# 复制此文件为 .env 并填入真实值
# ══════════════════════════════════════════

# ── 飞书应用凭证（唯一通讯通道） ──
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# ── 飞书群 Chat ID（所有消息发送到此群） ──
FEISHU_CHAT_ID=oc_xxxxxxxxxxxx

# ── 飞书 Bot 安全（open_id 白名单，逗号分隔，留空则不限制） ──
FEISHU_ALLOWED_SENDERS=

# ── 飞书输出控制（可选；超长内容会分多条/多张卡片发送，不截断） ──
FEISHU_TEXT_CHUNK_LIMIT=3500
FEISHU_CARD_CHUNK_LIMIT=3500
FEISHU_BOT_EXEC_MAX_BUFFER=16777216

# ── AI 模型 API Key（至少配置一个即可使用 AI 摘要功能） ──
DOUBAO_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# ── HTTP 网络恢复 ──
# IPv4/IPv6 自动择优时单个地址族的尝试等待时间。
HTTP_AUTO_SELECT_FAMILY_ATTEMPT_TIMEOUT_MS=250

# ── Four.meme 前端/API 频率与并发 ──
# 高频轻量模块，默认 2 秒，最低 1 秒。
FOURMEME_POOL_INTERVAL_SECONDS=2
FOURMEME_CONTRACT_INTERVAL_SECONDS=2
FOURMEME_ONCHAIN_INTERVAL_SECONDS=2
# 前端页面池默认 7 秒、最低 5 秒；API 结构和值默认 10 秒、最低 8 秒。
FOURMEME_FRONTEND_INTERVAL_SECONDS=7
FOURMEME_API_INTERVAL_SECONDS=10
# 稳定状态尽量贴近目标频率；调度抖动默认 100ms，设 0 可关闭。
FOURMEME_MODULE_JITTER_MS=100
# 前端抓取并发，默认 6/6；被风控时建议降到 4/4。
FOURMEME_FRONTEND_HTML_CONCURRENCY=6
FOURMEME_FRONTEND_ASSET_CONCURRENCY=6
# API 探针内部错峰，默认 150ms；不建议设 0，避免同域瞬时并发过高。
FOURMEME_API_PROBE_STAGGER_MS=150
# Four.meme 同 host 请求最小错峰，默认 60ms；设 0 可关闭，不改变模块监控间隔。
FOURMEME_HOST_REQUEST_MIN_DELAY_MS=60
# 新发现前端页面 warm-up 稳定轮数，默认 1；设 2 可降低 SSR 抖动误报。
FOURMEME_FRONTEND_WARMUP_STABLE_RUNS=1
# 全站路由/API 引用移除连续确认轮数；新增仍在首次发现时立即推送。
FOURMEME_FRONTEND_ROUTE_REMOVAL_CONFIRM_RUNS=2

# ── OpenFour 业务模板监控 ──
# 监控 /v1/public/token_template/search 的新模板上线和 status 变化，默认 2 秒、最低 1 秒。
OPENFOUR_TEMPLATE_INTERVAL_SECONDS=2
# 监听 OpenFourRegistry 链上 logs，触发新 module/token implementation 地址发现。
OPENFOUR_REGISTRY_LOG_MONITOR=true
OPENFOUR_REGISTRY_DISCOVERY_DEBOUNCE_MS=1000

# ── GitHub（可选，提升 API rate limit 至 5000/h） ──
GITHUB_TOKEN=
# 主仓库提交监控间隔：有 GITHUB_TOKEN 默认/最低 30 秒；无 token 默认/最低 90 秒。
GITHUB_INTERVAL_SECONDS=
# 账号仓库列表监控间隔：默认/最低 300 秒。提交监控不受这个间隔影响。
GITHUB_REPO_LIST_INTERVAL_SECONDS=300

# ── Four.meme 链上创建者动作监听（可选） ──
# Etherscan API V2 key；仅作为备用查询，BSC 使用 chainid=56，可能需要 paid tier。
ETHERSCAN_V2_API_KEY=
ETHERSCAN_API_KEY=
# 旧变量名兼容；优先级低于 ETHERSCAN_V2_API_KEY / ETHERSCAN_API_KEY。
BSCSCAN_API_KEY=
# 手动补充需要重点监听的钱包地址，多个用逗号分隔；通常不需要。
FOURMEME_WATCH_ACTORS=
FOURMEME_WATCH_CREATORS=
# 默认开启；设为 false 可关闭模块8。
FOURMEME_ACTOR_MONITOR=true
# 默认自动从 BscScan 合约地址页读取 Contract Creator/deployer 并缓存。
BSCSCAN_WEB_BASE=https://bscscan.com
FOURMEME_CREATOR_PAGE_LOOKUP=true
FOURMEME_CREATOR_PAGE_MAX_PER_RUN=2
FOURMEME_CREATOR_LOOKUP_COOLDOWN_MINUTES=30
# 页面抓取被封时，用 BSC RPC 在近期区块中反查新合约创建交易作为兜底。
FOURMEME_CREATOR_CHAIN_LOOKUP=true
FOURMEME_CREATOR_CHAIN_LOOKBACK_BLOCKS=30000
FOURMEME_CREATOR_CHAIN_MAX_BLOCKS_PER_RUN=120
# Etherscan V2 API 备用查询；页面抓取被封且 API key 支持 BSC getcontractcreation 时再开启。
FOURMEME_CREATOR_LOOKUP=false
# 创建者动作扫链：默认启用 WebSocket 新区块订阅；HTTP 扫描仍作为断线/漏事件兜底。
# FourMeme HTTP 链上读取节点；按负载、失败次数、延迟和退避状态自动轮转。
FOURMEME_BSC_RPC_URLS=https://bsc.rpc.blxrbdn.com,https://rpc.48.club,https://bnb-mainnet.g.alchemy.com/public,https://bsc-rpc.publicnode.com
BSC_WS_URLS=wss://bsc-rpc.publicnode.com
FOURMEME_ACTOR_WS_ENABLED=true
FOURMEME_ACTOR_HTTP_FALLBACK_MS=8000
# 默认 1 个确认块；每批 80 块，落后时同轮最多追 800 块。
FOURMEME_ACTOR_CONFIRMATIONS=1
FOURMEME_ACTOR_BOOTSTRAP_BLOCKS=20
FOURMEME_ACTOR_MAX_BLOCKS=80
FOURMEME_ACTOR_CATCHUP_MAX_BLOCKS=800
FOURMEME_ACTOR_MAX_RUN_MS=45000
FOURMEME_ACTOR_LAG_WARN_BLOCKS=120
FOURMEME_ACTOR_CATCHUP_LOG_MINUTES=5
FOURMEME_ACTOR_CATCHUP_LOG_DELTA_BLOCKS=5000

# ── Flap.sh 轮询 ──
# 页面与链上注册中心轮询间隔（毫秒），最低 500ms，默认 1000ms。
FLAP_POLL_INTERVAL_MS=1000

# ── Flap Factory 底池资产链上发现 ──
# 默认开启；只使用 BSC 只读 RPC，不签名、不发送交易。
FLAP_FACTORY_POOL_MONITOR=true
FLAP_FACTORY_PROXY=0xe2cE6ab80874Fa9Fa2aAE65D277Dd6B8e65C9De0
# 部署区块自动定位使用的历史状态节点；无论是否配置 BSC_RPC_URLS 都会作为只读降级节点加入。
FLAP_FACTORY_ARCHIVE_RPC_URL=https://bsc-mainnet.public.blastapi.io
# 链上扫描独立运行，不改变页面轮询间隔；默认 1 秒，最低 500ms。
FLAP_FACTORY_POOL_INTERVAL_MS=1000
# 实时 RPC 使用短超时和备用节点竞速；慢节点不会阻塞后续区块扫描。
FLAP_FACTORY_RPC_TIMEOUT_MS=2000
# 停机缺口的大区间补扫允许更长 RPC 超时，不影响 1 秒实时扫描。
FLAP_FACTORY_RPC_CATCHUP_TIMEOUT_MS=8000
FLAP_FACTORY_RPC_HEDGE_DELAY_MS=120
# Factory 新底池事件 WSS 加速通道；多个节点会并行订阅并按交易哈希+日志索引去重。
FLAP_FACTORY_WS_ENABLED=true
FLAP_FACTORY_WS_URLS=wss://bsc-rpc.publicnode.com,wss://bsc.publicnode.com
# WSS 首次订阅后回扫最近区块，允许 5000～20000，默认 10000；不执行全链历史扫描。
FLAP_FACTORY_WS_BACKFILL_BLOCKS=10000
# 回扫按 2000 块分段，兼容公共 RPC 的 eth_getLogs 范围限制；允许 100～5000。
FLAP_FACTORY_WS_BACKFILL_CHUNK_BLOCKS=2000
# 连续日志缺口补扫独立运行，默认每秒执行一次。
FLAP_FACTORY_CATCHUP_INTERVAL_MS=1000
# 留空或 0 时使用 eth_getCode 自动定位部署区块；节点不支持旧区块状态时可填写已验证区块。
FLAP_FACTORY_DEPLOYMENT_BLOCK=0
# 实时最新区块优先扫描参数；不等待确认区块。
FLAP_FACTORY_REALTIME_BOOTSTRAP_BLOCKS=20
FLAP_FACTORY_REALTIME_MAX_BLOCKS=20
# 连续游标落后时每轮补扫的最大区块数。
FLAP_FACTORY_CATCHUP_MAX_BLOCKS=2000
# 每轮复核部分已知资产，即使没有识别到调用也能发现当前配置变化。
FLAP_FACTORY_ASSET_REFRESH_PER_RUN=10
# 底池名称使用 GoPlus 免费免密 API，未收录或不可用时自动通过只读 RPC 获取 ERC-20 名称。
FLAP_FACTORY_TOKEN_METADATA_API_URL=https://api.gopluslabs.io/api/v1/token_security/56
FLAP_FACTORY_TOKEN_METADATA_TIMEOUT_MS=800
FLAP_FACTORY_TOKEN_METADATA_RETRY_MS=300000
